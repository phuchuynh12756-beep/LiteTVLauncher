<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false">

    <!-- Hình nền -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Lớp làm tối nền để chữ dễ đọc -->
    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Nội dung chính -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="20dp"
        android:paddingRight="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="36sp" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:format12Hour="EEEE, dd/MM/yyyy"
                android:format24Hour="EEEE, dd/MM/yyyy"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/row_bg"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/grid"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:text="Cài đặt  (MENU)"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:drawSelectorOnTop="false"
            android:fadingEdge="none"
            android:horizontalSpacing="8dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="6"
            android:overScrollMode="never"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />
    </LinearLayout>

    <!-- Bảng cài đặt trượt từ phải sang -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E6101018"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Cài đặt"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowPick"
            style="@style/Row"
            android:text="Chọn ảnh nền từ bộ nhớ / USB" />

        <TextView
            android:id="@+id/rowGrad"
            style="@style/Row" />

        <TextView
            android:id="@+id/rowDim"
            style="@style/Row" />

        <TextView
            android:id="@+id/rowAnim"
            style="@style/Row" />

        <TextView
            android:id="@+id/rowAuto"
            style="@style/Row" />

        <TextView
            android:id="@+id/rowClean"
            style="@style/Row"
            android:text="Dọn RAM ngay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nhấn BACK để đóng. Giữ nút OK trên một app để xem thông tin / gỡ app."
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
